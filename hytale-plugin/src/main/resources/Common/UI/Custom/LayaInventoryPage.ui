              Background: #243447;

              ItemSlot #Pack35Icon {
                Anchor: (Full: 0);
                ShowQualityBackground: true;
                ShowDurabilityBar: true;
                ShowQuantity: true;
              }
            }

          }

          $C.@TextButton #SortButton {
            Anchor: (Top: 8, Width: 230, Height: 40);
            Text: "Stack & Sort";
          }
        }

        Group #Gear {
          Anchor: (Width: 58, Height: 310, Left: 10);
          LayoutMode: Top;
          Label #GearLabel {
            Anchor: (Width: 58);
            Text: "Equipped";
            Style: (FontSize: 16, RenderBold: true, TextColor: #FFFFFF, HorizontalAlignment: Center);
          }

          ItemSlotButton #Gear0 {
            Anchor: (Width: 58, Height: 58, Top: 2, Full: 0);
            Background: #243447;

            ItemSlot #Gear0Icon {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowDurabilityBar: true;
              ShowQuantity: true;
              TooltipText: "Head";
            }
          }

          ItemSlotButton #Gear1 {
            Anchor: (Width: 58, Height: 58, Top: 2, Full: 0);
            Background: #243447;

            ItemSlot #Gear1Icon {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowDurabilityBar: true;
              ShowQuantity: true;
              TooltipText: "Chest";
            }
          }

          ItemSlotButton #Gear2 {
            Anchor: (Width: 58, Height: 58, Top: 2, Full: 0);
            Background: #243447;

            ItemSlot #Gear2Icon {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowDurabilityBar: true;
              ShowQuantity: true;
              TooltipText: "Hands";
            }
          }

          ItemSlotButton #Gear3 {
            Anchor: (Width: 58, Height: 58, Top: 2, Full: 0);
            Background: #243447;

            ItemSlot #Gear3Icon {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowDurabilityBar: true;
              ShowQuantity: true;
              TooltipText: "Legs";
            }
          }

          ItemSlotButton #Gear4 {
            Anchor: (Width: 58, Height: 58, Top: 2, Full: 0);
            Background: #243447;

            ItemSlot #Gear4Icon {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowDurabilityBar: true;
              ShowQuantity: true;
              TooltipText: "Shield";
            }
          }

        }
      }
    }
  }
}
