      Group #CommandBar {
        Anchor: (Left: 0, Right: 0, Top: 8, Height: 78);
        LayoutMode: Center;

        Group #BoxFollow {
          Anchor: (Width: 70, Height: 70, Right: 10);
          Background: #1A2030(0.95);
          Padding: (Full: 7);

          Button #BtnFollow {
            Anchor: (Width: 56, Height: 56);
            Style: (
              Default: (Background: (TexturePath: "LayaIcons/IconFollow.png", Color: #FFFFFF(0.82))),
              Hovered: (Background: (TexturePath: "LayaIcons/IconFollow.png", Color: #FFFFFF(1.0))),
              Pressed: (Background: (TexturePath: "LayaIcons/IconFollow.png", Color: #8FB8FF(1.0))),
              Sounds: $C.@ButtonSounds
