$C = "Common.ui";

Group {
  LayoutMode: CenterMiddle;

  Group #Panel {
    Anchor: (Width: 1320, Height: 540);
    Background: #345068(0.97);
    Padding: (Full: 3);
    LayoutMode: Left;

    Group #Inner {
      Anchor: (Width: 1314, Height: 534);
      Background: #303F53(0.96);
      Padding: (Full: 14);
      LayoutMode: Top;

      Label #Title {
        Text: "Laya  |  Companion";
        Style: (FontSize: 22, RenderBold: true, FontName: "Secondary", TextColor: #FFFFFF, HorizontalAlignment: Center);
      }

      Label #Selection {
        Anchor: (Top: 4);
        Text: "Click an item, then a target slot. Double/right-click sends a stack across.";
        Style: (FontSize: 13, TextColor: #A0A6AD, HorizontalAlignment: Center);
      }

      Group #Content {
        Anchor: (Height: 342, Top: 10);
        LayoutMode: Center;

