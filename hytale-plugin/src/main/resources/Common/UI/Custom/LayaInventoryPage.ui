$C = "Common.ui";

Group {
  LayoutMode: CenterMiddle;

  Group #Panel {
    Anchor: (Width: 1230, Height: 420);
    Background: #345068(0.97);
    Padding: (Full: 3);
    LayoutMode: Left;

    Group #Inner {
      Anchor: (Width: 1224, Height: 414);
      Background: #303F53(0.96);
      Padding: (Full: 14);
      LayoutMode: Top;

      Label #Title {
        Text: "Your Inventory  |  Laya";
        Style: (FontSize: 22, RenderBold: true, TextColor: #FFFFFF);
      }

      Label #Selection {
        Anchor: (Top: 4);
        Text: "Click an item, then a target slot. Double/right-click sends a stack across.";
        Style: (FontSize: 13, TextColor: #A0A6AD);
      }

      Group #Content {
        Anchor: (Height: 310, Top: 10);
        LayoutMode: Left;

